@model List<Paciente>

@{
    ViewData["Title"] = "Pacientes";
}

<h1>Pacientes</h1>
<p><a asp-action="Create">Novo paciente</a></p>

@if (Model.Count == 0)
{
    <p>Nenhum paciente cadastrado.</p>
}
else
{
    <div class="tabela-container" role="region" aria-label="Lista de pacientes" tabindex="0">
        <table>
            <thead>
                <tr>
                    <th scope="col">Nome</th>
                    <th scope="col">CPF</th>
                    <th scope="col">Telefone</th>
                    <th scope="col">Endereço</th>
                    <th scope="col">Data de nascimento</th>
                    <th scope="col">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var paciente in Model)
                {
                    <tr>
                        <td>@paciente.Nome</td>
                        <td>@paciente.Cpf</td>
                        <td>@paciente.Telefone</td>
                        <td>@paciente.Endereco</td>
                        <td>@paciente.DataNascimento.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@paciente.Id">Editar</a>
                            <a asp-action="Delete" asp-route-id="@paciente.Id">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
